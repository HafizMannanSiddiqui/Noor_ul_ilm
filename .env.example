# Database — SQLite file for a single server. For Postgres, change provider in prisma/schema.prisma
DATABASE_URL="file:./noor.db"

# Long random string (at least 32 characters). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# First super admin (created by `npm run setup`)
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL="admin@noorulilm.org"
ADMIN_PASSWORD="ChangeThisPassword!2026"

# Create demo accounts (brothers admin, sisters admin, scholars) for testing. NEVER true in production.
SEED_DEMO="true"
DEMO_PASSWORD="Demo!Pass2026"

# Show posts / texts that are not yet scholar-approved, with a "Draft" warning. Set "false" before launch.
SHOW_DRAFTS="true"

# Public site URL (used for share links and sitemap)
SITE_URL="http://localhost:3000"

# "Sign in with Google" for admins (free). Google Cloud Console > APIs & Services > Credentials >
# Create OAuth client ID (Web application). Authorized redirect URI: {SITE_URL}/admin/auth/google/callback
# Leave empty to hide the Google button. Admins still need an account with the same email.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
